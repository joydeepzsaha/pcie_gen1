CAPI=2:
name: fusesoc:pcie:tb_phy_transmit:1.0.0
description: TX unit testbench for phy_transmit (Gen1 x1 golden baseline, Phase 4b prep)

filesets:
  rtl:
    depend:
      - fusesoc:pcie:phy_transmit

  cocotb_tx:
    files:
      - test_phy_transmit_tx.py : {file_type : user, copyto : .}

  cocotb_tx_x4:
    files:
      - test_phy_transmit_tx_x4.py : {file_type : user, copyto : .}

  cocotb_stall:
    files:
      - test_phy_transmit_stall.py : {file_type : user, copyto : .}

  # sec 63 #7h Phase 3 -- the fence dump, shared from tb/scrambler/.  Own
  # fileset and own mirror targets; verilate_tx_golden and
  # verilate_phy_transmit_stall are untouched.
  fence_7h:
    files:
      - ../scrambler/fence_7h.sv
      - ../scrambler/fence_7h_bind_scram.sv
      - ../scrambler/fence_7h_bind_frame.sv
    file_type: systemVerilogSource

targets:
  # Gen1 x1 golden-baseline TX bench. phy_transmit as toplevel, MAX_NUM_LANES=1.
  # Drives ordered-set input into os_generator and observes per-lane PIPE output.
  # This is the reference the Phase 4b ownership-transition commit must stay
  # byte-identical against at x1.
  verilate_tx_golden:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_phy_transmit_tx
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_tx]
    toplevel : [phy_transmit]

  # x4 (MAX_NUM_LANES=4) TX bench. Phase 4b step A/B: exposes the internal
  # ordered_set_axis_async_fifo DATA_WIDTH=32 truncation (Hop 9) as an observed
  # per-lane failure, then proves the width fix restores lanes 1-3. Same TS1
  # template as the golden; asserts each lane emits lane_num = its index.
  verilate_tx_x4:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_phy_transmit_tx_x4
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GMAX_NUM_LANES=4
        - waiver.vlt
    filesets : [rtl, cocotb_tx_x4]
    toplevel : [phy_transmit]

  # Fix-arc 2 -- the PIPE-stalling bench, half B of tracker sec 54 #4.
  # lane_management.sv:571 hardwires `assign data_valid_o = '1;`, which reaches
  # pipe_data_valid_o through scrambler.sv:76, so the port is a registered
  # constant carrying no information.  Rung 9's mutant M11 survived all 8
  # targets for exactly this reason.  1 ordinary-PASS control arm observing the
  # constant directly (the cancellation OBSERVED, not inferred -- the same
  # pattern fix-arc 1 used for error_o before it was driven) and 1 expect_fail
  # row.  x1, since the defect is per-lane-identical and lane 0 shows it.
  verilate_phy_transmit_stall:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_phy_transmit_stall
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_stall]
    toplevel : [phy_transmit]

  # sec 63 #7h Phase 3 fence mirrors.  Identical filesets and options PLUS the
  # fence dump.  phy_transmit carries BOTH fenced modules -- frame_symbols and
  # the per-lane scrambler instances -- so one target fences both seams and the
  # frame_symbols stream doubles as the fix-independent control.
  fence_tx_golden:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_phy_transmit_tx
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_tx, fence_7h]
    toplevel : [phy_transmit]

  fence_phy_transmit_stall:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_phy_transmit_stall
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_stall, fence_7h]
    toplevel : [phy_transmit]
