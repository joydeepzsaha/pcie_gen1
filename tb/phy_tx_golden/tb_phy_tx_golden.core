CAPI=2:
name: fusesoc:pcie:tb_phy_tx_golden:1.0.0
description: Rung 9 spec-golden transmit benches (Base 2.1 ch.4 oracles) -- ordered sets, SKP, CDC, framing

filesets:
  rtl:
    depend:
      - fusesoc:pcie:phy_transmit

  cocotb_os_golden:
    files:
      - test_tx_os_golden.py : {file_type : user, copyto : .}

  cocotb_skp:
    files:
      - test_tx_skp.py : {file_type : user, copyto : .}

  cocotb_cdc:
    files:
      - test_tx_cdc.py : {file_type : user, copyto : .}

  cocotb_framing:
    files:
      - test_tx_framing.py : {file_type : user, copyto : .}

  # sec 63 #7h Phase 3 -- the fence dump.  frame_symbols is this target's
  # toplevel and sits UPSTREAM of the scrambler, so only the frame bind is
  # taken; `scrambler` is not in the design here.
  fence_7h_frame:
    files:
      - ../scrambler/fence_7h.sv
      - ../scrambler/fence_7h_bind_frame.sv
    file_type: systemVerilogSource
  # §63 #7j Phase 1: MEASUREMENT ONLY, zero oracles.  Emits raw timestamped
  # PIPE events; all pairing happens offline (§22.92).  Not a gate row.
  cocotb_7j_idle:
    files:
      - test_7j_idle.py : {file_type : user, copyto : .}

  cocotb_7j2_arb:
    files:
      - test_7j2_arb.py : {file_type : user, copyto : .}

  cocotb_7j2_idle:
    files:
      - test_7j2_idle.py : {file_type : user, copyto : .}

  probe_7j2_lm:
    files:
      - probe_7j2_lm.sv
    file_type : systemVerilogSource

targets:
  # Ordered sets checked against packers built from Base 2.1 Table 4-2 p.201,
  # Table 4-3 p.203 and Table 4-4 p.205.  The inherited verilate_tx_golden row
  # states in its own header that its expectations were "empirically
  # established" from DUT dumps; this row's are spec-derived.  Both are kept.
  verilate_tx_os_golden:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tx_os_golden
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_os_golden]
    toplevel : [phy_transmit]

  # SKP Ordered Set: composition and scheduling interval (Base 2.1 sec 4.2.7.1
  # p.261).  This target raises link_up_i, which is what arms os_generator's SKP
  # timer (os_generator.sv:139).  Every pre-Rung-9 bench holds it at 0, so
  # ST_SKP was dead in all 71 rows of the 03cea650 baseline.
  verilate_tx_skp:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tx_skp
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_skp]
    toplevel : [phy_transmit]

  # The two async-FIFO crossings driven at UNEQUAL frequencies.  Every earlier
  # bench starts all three clocks at 10 ns; Base 2.1 sec 4.2.7 p.261 guarantees
  # only that the Transmit and Receive clocks are within 600 ppm of each other,
  # never that they are equal.
  verilate_tx_cdc:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tx_cdc
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_cdc]
    toplevel : [phy_transmit]

  # frame_symbols standalone -- the one closure module with no bench of its own.
  # USER_WIDTH=5 matches the width phy_transmit instantiates it with
  # (phy_transmit.sv:12,130); the module default of 1 would truncate the K-mask
  # literals at frame_symbols.sv:148,182,187 and test something that is not in
  # the design.
  verilate_tx_framing:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tx_framing
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GUSER_WIDTH=5
        - waiver.vlt
    filesets : [rtl, cocotb_framing]
    toplevel : [frame_symbols]

  # sec 63 #7h Phase 3 fence mirror of verilate_tx_framing.  This one is the
  # CONTROL: frame_symbols is upstream of the scrambler, so the fix cannot reach
  # it and this stream must be bit-identical for a reason independent of the
  # fix.  verilate_tx_framing itself is untouched.
  fence_tx_framing:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tx_framing
      timescale: 1ns/1ns
      verilator_options:
        - -GUSER_WIDTH=5
        - waiver.vlt
    filesets : [rtl, cocotb_framing, fence_7h_frame]
    toplevel : [frame_symbols]

  # §63 #7j Phase 1 -- measurement only, NOT a gate row and deliberately so:
  # every test in it is a probe that asserts nothing, so it can neither pass nor
  # fail in a way an artifact could witness (§22.77's sibling).  It exists to
  # produce the raw event stream the Phase 1 report is built from.
  verilate_7j_idle:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_7j_idle
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_7j_idle]
    toplevel : [phy_transmit]

  # §63 #7j-2 Phase 1 -- measurement only, NOT a gate row, same reason as
  # verilate_7j_idle above: every row is a probe that asserts nothing, so it can
  # neither pass nor fail in a way an artifact could witness.
  #
  # It asks the one question #7j-2's shape raises and no existing row covers:
  # when Logical Idle is requested CONTINUOUSLY, can a packet still get out?
  # The seam is phy_transmit because the question is about the route from
  # gen_os_ctrl_i to pipe_data_o -- os_generator and lane_management -- and
  # that is where it is measured (§22.85).
  verilate_7j2_arb:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_7j2_arb
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_7j2_arb]
    toplevel : [phy_transmit]

  # §63 #7j-2 Phase 1 -- the same five probe rows with lane_management's own
  # arbitration state bound in.  A SEPARATE target from verilate_7j2_arb on
  # purpose (§63 #7d's rule): a probe that perturbs the row it measures is not a
  # measurement of that row, so the port-level rows keep a probe-free route.
  verilate_7j2_arb_lm:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_7j2_arb
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_7j2_arb, probe_7j2_lm]
    toplevel : [phy_transmit]

  # §63 #7j-2 -- THE ACCEPTANCE TARGET, and a GATE row (unlike the two probe
  # targets above).  Six rows for the four constraints at the phy_transmit
  # seam: C1/C2/C3 are red before the fix, C4/C5 are regression guards whose
  # power comes from a named mutant rather than from the unchanged tree, and C6
  # is the positive control every negative assertion here pairs with (§22.81).
  verilate_7j2_idle:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_7j2_idle
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_7j2_idle]
    toplevel : [phy_transmit]
