CAPI=2:
name: fusesoc:pcie:tb_scrambler_codec:1.0.0
description: Exhaustive spec-golden bench for decode_8b10b (Base 2.1 Appendix B)

# Oracles, page citations and the MindShare cross-check for every assertion live
# in pcie_docs/evidence/decode-8b10b/ORACLES_8B10B.md.  Expected values are
# computed from PCI Express Base Spec Rev 2.1 Tables B-1/B-2 by
# tb/scrambler/golden_8b10b.py, which carries those tables verbatim; none is
# captured from the DUT.
#
# decode_8b10b takes 10 code bits plus one running-disparity bit, so the input
# space is 2048 combinations and ALL of them are driven.  For a combinational
# module that is a complete proof rather than a sample -- the same standing as
# byte_scramble's 65536-state sweep in Rung 3.
#
# This is the first target in the repository to name a member of the 8b/10b codec
# as a toplevel.  The module is in the compile set of every phy_scrambler
# dependant but was elaborated by none of the 68 pre-existing gate rows; the
# testbenches that instantiated it were referenced by no .core.  See
# CENSUS_8B10B.md sec 5.  Of those two, tb/scrambler/test_8b10b.v was DELETED in
# the cleanup rung (0 of 99 gate targets elaborated it, no fileset named it);
# tb/dllp/tb_pcie_datalink_layer.v remains.

filesets:
  rtl:
    depend:
      - fusesoc:pcie:phy_scrambler

  golden:
    files:
      - golden_8b10b.py : {file_type : user, copyto : .}

  cocotb_decode:
    files:
      - test_decode_8b10b.py : {file_type : user, copyto : .}

  cocotb_encode:
    files:
      - test_encode_8b10b.py : {file_type : user, copyto : .}

  cocotb_stall:
    files:
      - test_scrambler_stall.py : {file_type : user, copyto : .}

  # Fix-arc 3 -- the O-ALIGN benches.  align_common.py carries the trace
  # machinery and the four clause detectors; both align targets depend on it.
  align_common:
    files:
      - align_common.py : {file_type : user, copyto : .}

  cocotb_align_scrambler:
    files:
      - test_scrambler_align.py : {file_type : user, copyto : .}

  cocotb_align_gen1:
    files:
      - test_gen1_align.py : {file_type : user, copyto : .}

  # Fix-arc 4 -- the O-KGAP bench, tracker sec 54 4c.  Its own helper on purpose:
  # align_common.py backs two green targets and a shared-helper edit could move
  # their rows for a reason unrelated to this rung.
  kgap_common:
    files:
      - kgap_common.py : {file_type : user, copyto : .}

  cocotb_kgap:
    files:
      - test_scrambler_kgap.py : {file_type : user, copyto : .}

  # Fix-arc 5c -- the spec-golden model behind O-SKPSEED.  Carries Base 2.1
  # sec 4.2.3's scrambling rules and byte_scramble.sv's (Rung-3-proven) advance
  # table; every expected value in the skpseed rows is computed from it and none
  # is captured from the DUT.
  skpseed_common:
    files:
      - skpseed_common.py : {file_type : user, copyto : .}

  cocotb_skpseed:
    files:
      - test_scrambler_skpseed.py : {file_type : user, copyto : .}

  # sec 63 #7h Phase 1 -- the residue measurement.  Its own helper for the same
  # reason kgap_common.py has one: align_common.py backs two green targets and a
  # shared-helper edit would move their rows for a reason unrelated to this rung.
  residue_7h_common:
    files:
      - residue_7h_common.py : {file_type : user, copyto : .}

  cocotb_residue_7h:
    files:
      - test_7h_residue.py : {file_type : user, copyto : .}

targets:
  # T6 -- decode_8b10b, exhaustively.  Purely combinational: no clock, no reset,
  # no state (CENSUS_8B10B.md sec 2), so running disparity enters as dispin and
  # leaves as dispout and the sequence tests chain the DUT's own dispout back
  # into its dispin.  No parameters exist on this module, so unlike the Rung-3
  # RX benches there is no second geometry to run.
  verilate_decode_8b10b:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_decode_8b10b
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, golden, cocotb_decode]
    toplevel : [decode_8b10b]

  # Fix-arc 2 -- the PIPE-stalling bench, half A of tracker sec 54 #4.
  # DUT is `scrambler`, the wrapper phy_transmit.sv:153 and phy_receive.sv:143
  # both instantiate, because data_valid_i is a REAL INPUT PORT here.  At the
  # phy_transmit boundary it is a compile-time constant (lane_management.sv:571
  # hardwires it), so no stimulus there can inject a stall -- that is the
  # cancellation, and it is why sec 54 #4's two halves need two DUTs.  The
  # companion row is verilate_phy_transmit_stall.
  #
  # Method is a differential black box: the same symbols are driven twice from
  # the same reset, once with a data_valid gap, and the two capture lists are
  # compared.  Nothing is probed inside the DUT and no expected value is
  # captured from it.  3 ordinary-PASS control arms (the scrambler really
  # scrambles; two no-stall runs are byte-identical, which is what makes the
  # difference attributable; the pipeline really freezes) plus 2 expect_fail
  # rows carrying ONE divergence each (sec 22.66): the stream changes across a
  # gap, and it never resynchronises afterwards.
  verilate_scrambler_stall:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_scrambler_stall
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_stall]
    toplevel : [scrambler]

  # Fix-arc 3 -- the O-ALIGN pair, settling P2.g (FA-2 left it NOT MEASURED and
  # named the oracle as FA-3's first task; tracker sec 59.7 (3)).
  #
  # The question: which valid correctly frames the scrambled data at the
  # wrapper's producer boundary -- gen1_scramble.sv:282's depth-matched
  # publication, or scrambler.sv:76's 1-stage copy?  F-5 and P2.g both read the
  # 1-stage copy as a THREE-CYCLE SKEW, which would make the sec 54 #4 fix three
  # edits instead of two.
  #
  # TWO toplevels, because each candidate is then observed BLACK BOX at its own
  # module boundary with no internal probe.  data_out_o is the same signal in
  # both (scrambler.sv:85 assigns it straight from gen1_data), so the targets
  # differ in the valid alone -- the variable under test.
  #
  # The measurement is deliberately VALUE-FREE: it counts published beats,
  # republished words and pipeline advances published with valid low, and never
  # compares a data value against a model.  Half A of sec 54 #4 is unfixed when
  # these rows first run, so the scrambled VALUES are corrupted after a gap; a
  # value-comparing bench would fail on that and never reach the alignment
  # question.  The same rows therefore run unchanged before and after the fix.
  #
  # Both gap lengths 5 and 9 are driven everywhere, because "this defect does
  # not depend on gap length" is a measurement only if two lengths were driven.
  verilate_scrambler_align:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_scrambler_align
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, align_common, cocotb_align_scrambler]
    toplevel : [scrambler]

  # Candidate A, at gen1_scramble's own boundary.  scrambler.sv:61 wires this
  # output to `gen1_valid` and gen1_valid is NEVER READ -- its only other
  # occurrence is a commented-out line at :91 inside the disabled Gen3 mux.
  # That commented line is an invitation to wire it up, and these two
  # expect_fail rows are the reason not to: the chain holds through a gap
  # (republishing one stale Symbol per gap clock) and swallows exactly one real
  # Symbol on resume.
  verilate_gen1_align:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_gen1_align
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, align_common, cocotb_align_gen1]
    toplevel : [gen1_scramble]

  # Fix-arc 4 -- O-KGAP, tracker sec 54 4c.  FA-3 registered 4c as a QUESTION,
  # not a finding: gen1_scramble clears scramble_reset / stop_scrambling /
  # skp_os on EVERY clock while the COM that raises them and the LFSR reset that
  # consumes them both sit inside `if (data_valid_i)`.  Raised inside the guard,
  # cleared outside it, consumed inside it.  No bench drove K codes across a gap,
  # so it stayed unmeasured; this is that bench.
  #
  # DUT is `scrambler` (the wrapper both phy_transmit and phy_receive
  # instantiate) because data_valid_i is a real input port there AND, since
  # fix-arc 3 closed sec 54 #4, a real signal at the integrated boundary too --
  # lane_management.sv:582 drives data_valid_r where it hardwired '1.  So these
  # gaps are reachable in the shipping configuration, not hypothetical.
  #
  # Method: differential black box.  The same Symbols are driven twice from the
  # same reset, once with a gap, and the two published sequences are compared.
  # The gap OFFSET is SWEPT across a window around the COM rather than guessed,
  # so the result localises the loss to an exact clock instead of saying "a gap
  # near a COM changes things"; both gap lengths are driven at every offset.
  # 3 ordinary-PASS controls, 1 ordinary-PASS localiser that is true before AND
  # after the fix, and 2 expect_fail rows carrying ONE divergence each (sec
  # 22.66) -- the COM arm and the SKP arm.
  #
  # Unlike the O-ALIGN rows this bench may compare VALUES, and that is a
  # consequence of sec 54 #4 being closed: with it open, every gap corrupted
  # every later value and a value-comparing bench would have saturated.
  verilate_scrambler_kgap:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_scrambler_kgap
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, kgap_common, cocotb_kgap]
    toplevel : [scrambler]

  # Fix-arc 5c -- O-SKPSEED, tracker sec 54 #9(B).  WHAT LFSR VALUE FOLLOWS A
  # SKP ORDERED SET.
  #
  # Base 2.1 sec 4.2.3 p.199 initializes the LFSR on EVERY COM ("every time a
  # COM enters the Receive LFSR ... the LFSR ... is initialized", seed FFFFh) and
  # exempts only the SKP from the eight-shift advance.  A SKP Ordered Set is
  # COM + 3x SKP and the spec makes no exemption for its COM, so the first data
  # Symbol after the Ordered Set is XORed with FFFFh itself.
  #
  # WHY THIS TARGET EXISTS.  gen1_scramble.sv:73 is what delivers that FFFFh --
  # :284 takes `if (!is_skp_os)`, so a SKP Ordered Set's COM never raises
  # scramble_reset and skp_os carries the initialise alone.  The line READS like
  # a defect and was registered as sec 54 #9(B) on that reading across two recon
  # passes.  Fix-arc 5c measured both directions: as written the post-Ordered-Set
  # data matches the spec model at phase 0, all 20 words bit exact; rewritten as
  # the "obvious" three-way hold it matches only at phase +17, corrupting every
  # later data Symbol permanently.
  #
  # NO EXISTING ROW CAUGHT THAT.  The 4c rows are SCHEDULE differentials -- a
  # gapped run against a gap-free reference from the SAME build -- so under the
  # rewrite both move together and both stay green, and the regression would
  # have landed behind a fully green gate.  These are the missing oracle.
  #
  # Method: the published stream is compared against skpseed_common.py, which
  # carries the spec tables; nothing is probed inside the DUT and no expected
  # value is captured from it.  The publication skew is DERIVED from each run
  # (the Ordered Set's K beats locate it) rather than hardcoded.  3 ordinary-PASS
  # rows: 1 measurement carrying ONE divergence (sec 22.66) plus 2 controls --
  # that the phase is uniquely determined, and that the model does not fit the
  # data preceding the Ordered Set.
  #
  # These are ordinary PASS, not expect_fail: they pass because the RTL is
  # CORRECT, and they guard against a future "repair".
  verilate_scrambler_skpseed:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_scrambler_skpseed
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, kgap_common, skpseed_common, cocotb_skpseed]
    toplevel : [scrambler]

  # T7 -- encode_8b10b, exhaustively.  9 data bits + 1 disparity bit = 1024
  # combinations, all driven.  Unlike the decoder, only 536 of them have a
  # spec-defined output: k=1 with a byte that is not one of the twelve Special
  # Symbols is a request Base 2.1 gives no encoding for, and this module has NO
  # error output to reject it with.  The bench asserts on the 536 and reports the
  # 488 as declined rather than skipping them silently.
  #
  # The round trip through the decoder is deliberately NOT the verdict -- an
  # encoder and its exact inverse round-trip perfectly whether or not either
  # matches the spec.  Comparison is against the transcribed Appendix B.
  verilate_encode_8b10b:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_encode_8b10b
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, golden, cocotb_encode]
    toplevel : [encode_8b10b]

  # sec 63 #7h Phase 1 -- #21: does a TLP's tail wait for the next ordered-set
  # slot?  MEASUREMENT ONLY (D-7H.1/D-7H.2): every row reports numbers and
  # asserts only its known-answer self-test and a non-vacuity check.  No row
  # asserts a spec property, because the fix shape is chat's to choose at the
  # Phase 2 STOP and a row that asserted the answer here would be deciding it.
  #
  # DUT is `scrambler`, the wrapper phy_transmit.sv:153 instantiates on the TX
  # path and phy_receive.sv:143 instantiates on the RX path.  The two directions
  # are the SAME MODULE, not merely the same class, so one target measures both
  # -- which is what makes D-7H.3's ownership unit "shared PHY TX/RX".
  #
  # Symbol identity is carried by data_k, not by data value: Base 2.1 sec 4.2.3
  # p.199 says K codes are not scrambled, so a tag survives the transform
  # unchanged and the known-answer check (a tag presented on clock t appears at
  # data_k_out_o on clock t+DEPTH under continuous valid) is hand-derivable and
  # independent of the scrambler's arithmetic.
  verilate_7h_residue:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_7h_residue
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, residue_7h_common, cocotb_residue_7h]
    toplevel : [scrambler]
