CAPI=2:
name: fusesoc:pcie:tb_phy_receive:1.0.0
description: Spec-golden RX benches for the phy_receive closure (Base 2.1 ch.4, Gen1 x1)

# Oracles, citations and the MindShare cross-check for every assertion in these
# benches live in pcie_docs/evidence/phy-rx-golden/ORACLES_PHY_RX.md.  Expected
# values are computed from PCI Express Base Spec Rev 2.1 by tb/phy_receive/rx_golden.py;
# none is captured from the DUT.

filesets:
  rtl:
    depend:
      - fusesoc:pcie:phy_receive

  scrambler_rtl:
    depend:
      - fusesoc:pcie:phy_scrambler

  golden:
    files:
      - rx_golden.py : {file_type : user, copyto : .}

  cocotb_lfsr:
    files:
      - test_rx_lfsr.py : {file_type : user, copyto : .}

  cocotb_descramble:
    files:
      - test_rx_descramble.py : {file_type : user, copyto : .}

  cocotb_os:
    files:
      - test_rx_os.py : {file_type : user, copyto : .}

  cocotb_closure:
    files:
      - test_rx_closure.py : {file_type : user, copyto : .}

  # SS63 #7c: block_alignment's FIRST bench.  The module carries 148 of the
  # design's 149 latch primitives and a live functional defect (F16), and until
  # this rung no gate target drove it as a toplevel -- it was only ever
  # exercised transitively, by rows asserting things about other modules.
  # §63 #7d: data_handler's first bench -- defect B, the tkeep 0x7/0x3 boundary.
  cocotb_data_handler:
    files:
      - test_data_handler.py : {file_type : user, copyto : .}

  cocotb_block_alignment:
    files:
      - test_block_alignment.py : {file_type : user, copyto : .}
      # P6 replays a CAPTURED valid cadence, so the capture ships with the
      # bench.  copyto is required: the .py resolves the trace relative to its
      # own __file__, which at run time is the staged copy, not the tree.
      - fullstack_gap_trace.txt : {file_type : user, copyto : .}

  # §63 #7j Phase 1-b: MEASUREMENT ONLY, zero oracles.  Raw events only;
  # all pairing offline (§22.92).  Not a gate row.
  cocotb_7j_rx_idle:
    files:
      - test_7j_rx_idle.py : {file_type : user, copyto : .}

  # §63 #7j-1: the receive-path acceptance rows.  The two golden tables from
  # Base 2.1 p.700 ship with the bench (copyto, like fullstack_gap_trace.txt)
  # because the known-answer row resolves them relative to its own __file__,
  # which at run time is the staged copy rather than the tree.
  cocotb_7j_accept:
    files:
      - test_7j_rx_accept.py : {file_type : user, copyto : .}
      - p700_tables.json : {file_type : user, copyto : .}

targets:
  # T1 -- byte_scramble, the 8-shift LFSR advance of Base 2.1 App. C.1 p.698.
  # Combinational and 16 bits of state, so the oracle is settled EXHAUSTIVELY
  # (all 65536 states), then anchored against the two golden tables printed in
  # Base 2.1 p.700.
  verilate_rx_lfsr:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_rx_lfsr
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [scrambler_rtl, golden, cocotb_lfsr]
    toplevel : [byte_scramble]

  # T2 -- gen1_scramble, the Gen1 descrambler, at pipe_width_i=8 (one Symbol per
  # clock).  Oracles A2-A8: seed FFFFh, COM re-seeds, SKP does not advance the
  # LFSR, K codes and TS bodies are not descrambled, and the LFSR advances once
  # per Symbol.  Expected streams come from the Appendix C.1 golden model.
  verilate_rx_descramble:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_rx_descramble
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [scrambler_rtl, golden, cocotb_descramble]
    toplevel : [gen1_scramble]

  # T3 -- ordered_set_handler at pipe_width_i=8.  TS1/TS2 recognition (Tables 4-2
  # and 4-3), Lane polarity inversion (4.2.4.4 p.208), the EIOS (Table 4-4) and
  # the EIEOS (Table 4-5, which does not exist at 2.5 GT/s).  eieos_valid_o is
  # observable only here -- phy_receive.sv:180 discards the port.
  verilate_rx_os:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_rx_os
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, golden, cocotb_os]
    toplevel : [ordered_set_handler]

  # T4 -- the whole phy_receive closure at MAX_NUM_LANES=1: scrambler ->
  # ordered_set_handler per lane, then block_alignment -> pack_data ->
  # data_handler -> axis_register -> axis_async_fifo.  Drives PIPE Symbols and
  # asserts the top-level ports.
  verilate_rx_closure:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_rx_closure
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, golden, cocotb_closure]
    toplevel : [phy_receive]

  # T5 -- the same bench at MAX_NUM_LANES=3.  Brief sec 2's geometry rule asks a
  # depth-parameterized structure to be re-run at a non-power-of-two size; this
  # closure has no elastic buffer to vary (both FIFO instantiations are commented
  # out, phy_receive.sv:229-261), so the rule is discharged against the lane
  # count.  Three exercises the per-lane generate and the MAX_NUM_LANES-derived
  # bus widths off every power-of-two boundary, killing wrap and off-by-one
  # mutants that x1 and x4 are both blind to.
  verilate_rx_closure_x3:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_rx_closure
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GMAX_NUM_LANES=3
        - waiver.vlt
    filesets : [rtl, golden, cocotb_closure]
    toplevel : [phy_receive]

  # ---------------------------------------------------------------------------
  # SS63 #7c T6 -- block_alignment alone, five acceptance properties.
  #
  # !! RED BEFORE THE FIX, BY CONSTRUCTION.  Written against the broken RTL so
  # that the fix is what turns it green; rows that only ever existed after a fix
  # cannot tell you the fix did anything.
  # ---------------------------------------------------------------------------
  verilate_block_alignment:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_block_alignment
      timescale: 1ns/1ns
      verilator_options:
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, cocotb_block_alignment]
    toplevel : [block_alignment]

  # ---------------------------------------------------------------------------
  # §63 #7d -- data_handler alone, the module that OWNS tkeep/tlast. Its first
  # bench. BRIEF_7D aimed bench 2a at pack_data; Phase 1 measured that pack_data
  # has no tkeep/tlast port in either direction and the AXIS boundary is born
  # here, so rows 1-4 of that bench are translated onto this module.
  #
  # !! RED BEFORE THE FIX, BY CONSTRUCTION -- the broken RTL emits tkeep 0x7 on
  # tlast where a six-byte DLLP requires 0x3.
  # ---------------------------------------------------------------------------
  verilate_data_handler:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_data_handler
      timescale: 1ns/1ns
      verilator_options:
        - -GMAX_NUM_LANES=1
        # §63 #7i: USER_WIDTH=5, which is what BOTH stacks pass
        # (pcie_phy_top.sv:259, pcie_endpoint_top.sv:547).  This target used the
        # module's default of 1, and at width 1 the receive tuser encoding has
        # never worked: axis_user_demux reads bit 1 as "is TLP", and the literal
        # data_handler used to emit -- 4'b0010 -- truncates to 1'b0 there, so a
        # TLP was indistinguishable from nothing.  The bench does not read tuser,
        # which is why nobody noticed; commit C's elaboration guard is what made
        # the latent misconfiguration loud.  ⭐ §22.95's radius pass found this,
        # and it is exactly the case the handshake says the pass earns its cost
        # on: seven agreeing targets are not evidence about the eighth.
        - -GUSER_WIDTH=5
        - waiver.vlt
    filesets : [rtl, cocotb_data_handler]
    toplevel : [data_handler]

  # §63 #7j Phase 1-b -- measurement only, NOT a gate row: every test is a probe
  # that asserts nothing, so no artifact could witness it either way.  It feeds
  # phy_receive a spec-golden, continuously-valid Logical Idle stream -- the
  # shape #7j-2 would put on the wire -- and records what comes out.
  verilate_7j_rx_idle:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_7j_rx_idle
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, golden, cocotb_7j_rx_idle]
    toplevel : [phy_receive]

  # §63 #7j-1 -- the RX acceptance rows for a continuous Logical Idle stream.
  # APPENDED LAST in TARGETS so the artifact keeps its existing row order and
  # the prefix link stays checkable with head -N.
  verilate_7j_rx_accept:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_7j_rx_accept
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl, golden, cocotb_7j_accept]
    toplevel : [phy_receive]
