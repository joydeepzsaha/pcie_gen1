CAPI=2:
name: fusesoc:pcie:tb_tlp:1.0.0
description: >
  Verilator+cocotb baseline harness for Joy's WIP Transaction Layer (src/tlp,
  introduced "WIP TLP, not yet tested" @ e376b99). Wires the pre-existing but
  un-runnered tb/tlp/{tb_tlp_*.sv + test_tlp_*.py} benches into kourosh's
  FuseSoC verilate-golden discipline. Per-module targets; enumeration-spine
  modules (requester -> generator -> parser -> tracker -> completion) first.
  RTL comes from ::tlp_core:1.0.0 (Joy's core) unchanged; tb-only, no src edits.

filesets:
  # Joy's TL RTL (all of src/tlp, tlp_pkg first) + shared Verilator waiver.
  rtl:
    depend:
      - ::tlp_core:1.0.0
      - fusesoc:pcie:lint

  # Per-module SystemVerilog wrapper benches (flatten struct ports for cocotb).
  bench_requester:
    files:
      - tb_tlp_requester.sv
    file_type: systemVerilogSource
  bench_request_tracker:
    files:
      - tb_tlp_request_tracker.sv
    file_type: systemVerilogSource
  bench_parser:
    files:
      - tb_tlp_parser.sv
    file_type: systemVerilogSource
  bench_generator:
    files:
      - tb_tlp_generator.sv
    file_type: systemVerilogSource
  bench_completion_control:
    files:
      - tb_tlp_completion_control.sv
    file_type: systemVerilogSource
  bench_comb:
    files:
      - tb_tlp_comb.sv
    file_type: systemVerilogSource
  bench_payload_formatter:
    files:
      - tb_tlp_payload_formatter.sv
    file_type: systemVerilogSource
  bench_credit_manager:
    files:
      - tb_tlp_credit_manager.sv
    file_type: systemVerilogSource
  bench_vc_buffer:
    files:
      - tb_tlp_vc_buffer.sv
    file_type: systemVerilogSource

  # TL conformance sweep: parser wrapper exposing poisoned/attributes/BE.
  bench_conf_parser:
    files:
      - tb_tlp_conf_parser.sv
    file_type: systemVerilogSource

  # cocotb test modules (copied into the work root at build time).
  cocotb_requester:
    files:
      - test_tlp_requester.py : {file_type : user, copyto : .}
  cocotb_request_tracker:
    files:
      - test_tlp_request_tracker.py : {file_type : user, copyto : .}
  cocotb_parser:
    files:
      - test_tlp_parser.py : {file_type : user, copyto : .}
  cocotb_generator:
    files:
      - test_tlp_generator.py : {file_type : user, copyto : .}
  cocotb_completion_control:
    files:
      - test_tlp_completion_control.py : {file_type : user, copyto : .}
  cocotb_comb:
    files:
      - test_tlp_comb.py : {file_type : user, copyto : .}
  cocotb_payload_formatter:
    files:
      - test_tlp_payload_formatter.py : {file_type : user, copyto : .}
  cocotb_compile:
    files:
      - test_tlp_compile.py : {file_type : user, copyto : .}
  cocotb_credit_manager:
    files:
      - test_tlp_credit_manager.py : {file_type : user, copyto : .}
  cocotb_vc_buffer:
    files:
      - test_tlp_vc_buffer.py : {file_type : user, copyto : .}
  cocotb_vc_buffer_wrap:
    files:
      - test_tlp_vc_buffer_wrap.py : {file_type : user, copyto : .}

  # Four whole-layer tests that had never been referenced by any .core, of any
  # flow, in the tree's history -- `git log -S'end_to_end' -- tb/tlp/tb_tlp.core`
  # is empty.  They need no bench wrapper: every signal they touch is a real
  # tlp_layer port, including outstanding_o.
  cocotb_end_to_end:
    files:
      - test_tlp_end_to_end.py : {file_type : user, copyto : .}

  # Flow-control gating driven at the tlp_layer level: proves the credit
  # accounting fix where it throttles real traffic (vc_packet_ready,
  # tlp_layer.sv:280), not just at the credit manager's own boundary.
  cocotb_credit_integration:
    files:
      - test_tlp_credit_integration.py : {file_type : user, copyto : .}

  # Commit 1: CFG0 -> CPL spine, driven at the tlp_layer level.
  cocotb_cfg0_spine:
    files:
      - test_tlp_cfg0_spine.py : {file_type : user, copyto : .}

  # D-1b: CFG1 -> CPL spine, driven at the tlp_layer level (cfg0 precedent).
  cocotb_cfg1_spine:
    files:
      - test_tlp_cfg1_spine.py : {file_type : user, copyto : .}

  # D-1b: CFG1 origination -- on-wire goldens + (offset x byte_count)
  # admission matrix re-proven for the Type 1 commands.
  cocotb_conf_cfg1:
    files:
      - test_tlp_conf_cfg1.py : {file_type : user, copyto : .}

  # TL conformance sweep -- spec-golden, driven at the tlp_layer level.
  cocotb_conf_requester:
    files:
      - test_tlp_conf_requester.py : {file_type : user, copyto : .}
  cocotb_conf_tracker:
    files:
      - test_tlp_conf_tracker.py : {file_type : user, copyto : .}
  cocotb_conf_parser:
    files:
      - test_tlp_conf_parser.py : {file_type : user, copyto : .}
  cocotb_conf_completion:
    files:
      - test_tlp_conf_completion.py : {file_type : user, copyto : .}
  cocotb_conf_generator:
    files:
      - test_tlp_conf_generator.py : {file_type : user, copyto : .}
  cocotb_conf_classifier:
    files:
      - test_tlp_conf_classifier.py : {file_type : user, copyto : .}
  cocotb_conf_formatter:
    files:
      - test_tlp_conf_formatter.py : {file_type : user, copyto : .}

  # config/IO byte-enable admission matrix: which (offset, byte_count) shapes
  # the requester accepts, and that every accepted one is a single 1-DW TLP.
  cocotb_conf_cfgbe:
    files:
      - test_tlp_conf_cfgbe.py : {file_type : user, copyto : .}

  # command_data_last_i contract probe (evidence for Joy): spurious
  # command_error_o on valid multi-segment writes + malformed-TLP on early last.
  cocotb_conf_datalast:
    files:
      - test_tlp_conf_datalast.py : {file_type : user, copyto : .}

  # Completion Timeout (PCIe Base 2.1 SS2.8).  Two modules: the mechanism at a
  # deliberately small CPL_TIMEOUT_CYCLES so an expiry costs 64 cycles instead
  # of 4096, and a separate one that pins the shipped default.
  cocotb_cpl_timeout:
    files:
      - test_tlp_cpl_timeout.py : {file_type : user, copyto : .}
  cocotb_cpl_timeout_default:
    files:
      - test_tlp_cpl_timeout_default.py : {file_type : user, copyto : .}

  # sec 63 #7g-2 Phase 1 -- NOT A GATE ROW: the 32-phase Completion Timeout
  # sweep (C-7G2-7).  Own fileset, own target.
  cocotb_7g2_sweep:
    files:
      - test_7g2_cpl_sweep.py : {file_type : user, copyto : .}

targets:
  # ---- Enumeration spine (the CfgRd0 -> CPL path RC enumeration needs) ----

  # tlp_requester: originates MemRd/MemWr/IORd/IOWr and CfgRd0/CfgWr0
  # (src/tlp/tlp_requester.sv:116-118). NOTE: the bundled test drives only
  # MEM_READ/MEM_WRITE (cmd 0/1) -- a CfgRd0 (cmd 2) stimulus is Commit-1 work.
  verilate_tlp_requester:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_requester
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_requester, cocotb_requester]
    toplevel : [tb_tlp_requester]

  # tlp_request_tracker: allocates tags, matches returning CPLs by tag+RID.
  verilate_tlp_request_tracker:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_request_tracker
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_request_tracker, cocotb_request_tracker]
    toplevel : [tb_tlp_request_tracker]

  # tlp_parser: deserializes RX TLP incl. completion header layout.
  verilate_tlp_parser:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_parser
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_parser, cocotb_parser]
    toplevel : [tb_tlp_parser]

  # tlp_generator (+ tlp_payload_formatter): serializes header+payload to AXIS.
  verilate_tlp_generator:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_generator
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_generator, cocotb_generator]
    toplevel : [tb_tlp_generator]

  # tlp_completion_generator + tlp_control: builds CPL and arbitrates the
  # requester/completion paths into the single generator.
  verilate_tlp_completion_gen:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_completion_control
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_completion_control, cocotb_completion_control]
    toplevel : [tb_tlp_completion_control]

  # ---- Secondary (combinational blocks + payload realignment) ----

  # tlp_classifier + tlp_bar_decoder + tlp_config_decoder + tlp_pkg helpers.
  verilate_tlp_comb:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_comb
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_comb, cocotb_comb]
    toplevel : [tb_tlp_comb]

  verilate_tlp_payload_formatter:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_payload_formatter
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_payload_formatter, cocotb_payload_formatter]
    toplevel : [tb_tlp_payload_formatter]

  # ---- Full-layer smoke: only thing that exercises tlp_layer end to end ----
  # No SV wrapper -- drives tlp_layer's real _i/_o ports directly.
  verilate_tlp_compile:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_compile
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_compile]
    toplevel : [tlp_layer]

  # ---- Commit 1: first-ever RC CfgRd0/CfgWr0 -> CPL round trip ----
  # Drives tlp_layer's real command_* / s_dllp_axis ports directly; asserts the
  # emitted config-request TLP against the PCIe spec and catches a hand-rolled
  # spec-derived completion in the request tracker.
  verilate_tlp_cfg0_spine:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_cfg0_spine
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_cfg0_spine]
    toplevel : [tlp_layer]

  # ---- D-1b: CFG1 (Type 1 config) -> CPL spine ----
  # CfgRd1/CfgWr1 out the TX AXIS (whole-DW0 goldens -- Trap A), hand-rolled
  # spec-golden Cpl/CplD back with the echoed tag+RID, tracker correlation
  # (F1b.4), outstanding -> 0, no unexpected-completion.
  verilate_tlp_cfg1_spine:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_cfg1_spine
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_cfg1_spine]
    toplevel : [tlp_layer]

  # ---- D-1b: CFG1 origination, requester level ----
  # On-wire CfgRd1/CfgWr1 goldens (F1b.1/F1b.2), the full offset x byte_count
  # admission matrix re-proven for the Type 1 commands (F1b.3), and the
  # anti-segmentation proof that over-length CFG1 is rejected, never split on
  # MPS/MRRS (F1b.5).
  verilate_tlp_conf_cfg1:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_cfg1
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_conf_cfg1]
    toplevel : [tlp_layer]

  # ---- TL conformance sweep, Area 1: requester origination completeness ----
  # MemRd/MemWr/IORd/IOWr headers, 3DW vs 4DW, first/last-BE, 4KB + MPS/MRRS
  # segmentation.  All golden hand-derived from the PCIe spec.
  verilate_tlp_conf_requester:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_requester
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_conf_requester]
    toplevel : [tlp_layer]

  # ---- TL conformance sweep, Area 2: request tracker stress ----
  # tag exhaustion, out-of-order, multi-CPL byte accounting, duplicate,
  # unexpected, malformed-CPL rejection, result backpressure.
  verilate_tlp_conf_tracker:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_tracker
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_conf_tracker]
    toplevel : [tlp_layer]

  # ---- TL conformance sweep, Area 3: parser robustness ----
  # all classes 3DW/4DW, prefix, ECRC digest, poisoned, truncated/bad-keep
  # rejection, reset-mid-packet recovery.  Driven through tb_tlp_conf_parser.
  verilate_tlp_conf_parser:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_parser
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_conf_parser, cocotb_conf_parser]
    toplevel : [tb_tlp_conf_parser]

  # ---- TL conformance sweep, Area 4 (+ Area 6 control): completion fields ----
  # CPL vs CPLD, status codes, byte-count/lower-address, tag/RID/CID echo, and
  # control completion-over-requester arbitration.  Reuses tb_tlp_completion_control.
  verilate_tlp_conf_completion:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_completion
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_completion_control, cocotb_conf_completion]
    toplevel : [tb_tlp_completion_control]

  # ---- TL conformance sweep, Area 4b: CPL/CPLD on-wire serialization ----
  verilate_tlp_conf_generator:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_generator
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_generator, cocotb_conf_generator]
    toplevel : [tb_tlp_generator]

  # ---- TL conformance sweep, Area 5: classifier ----
  # posted/NP/CPL routing + unknown/AtomicOp/4DW/over-length/bad-CPL rejections.
  verilate_tlp_conf_classifier:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_classifier
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_comb, cocotb_conf_classifier]
    toplevel : [tb_tlp_comb]

  # ---- Config/IO byte-enable admission matrix (anti-split regression) ----
  # Locks the tlp_requester admission guard: a config/IO request is legal iff
  # it fits inside one DW (byte_count <= 4 - address[1:0]), and every admitted
  # one emits exactly one TLP with length_dw=1 and last_be=0.  The rejected
  # half exists because CFG @0x19 bc=4 used to emit TWO config TLPs, which
  # PCIe Base 2.1 SS2.2.7 forbids.
  verilate_tlp_conf_cfgbe:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_cfgbe
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_conf_cfgbe]
    toplevel : [tlp_layer]

  # ---- command_data_last_i contract probe (evidence for Joy) ----
  # Reuses the tb_tlp_requester wrapper (already exposes command_data_last /
  # packet_data_last / packet_length_dw / command_error).  Test 2 asserts the
  # defined early-last violation behavior (command_error_o + REQ_IDLE recovery).
  verilate_tlp_conf_datalast:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_datalast
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_requester, cocotb_conf_datalast]
    toplevel : [tb_tlp_requester]

  # ---- TL conformance sweep, Area 6: payload_formatter realignment ----
  verilate_tlp_conf_formatter:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_conf_formatter
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_payload_formatter, cocotb_conf_formatter]
    toplevel : [tb_tlp_payload_formatter]

  # ---- Completion Timeout: the mechanism, at CPL_TIMEOUT_CYCLES=64 ----------
  # T1 exact-cycle fire, T2 the wedge regression (TAG_COUNT+2 unanswered
  # requests recover -- this one FAILS against cc1e194), T3 timer restart on a
  # partial CPL, T4 late-completion drain + tag reuse, T5 second expiry.
  # 64 rather than the 4096 default purely so the sim is short; the mechanism
  # is value-independent and the default is pinned by the next target.
  verilate_tlp_cpl_timeout:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_cpl_timeout
      timescale: 1ns/1ns
      verilator_options:
        # The exact-cycle assertions read the tracker's own cycle_counter_r and
        # alloc_time_r rather than mirroring them in Python -- a mirror raced
        # the scheduler and was wrong twice before this.
        - --public-flat-rw
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_request_tracker, cocotb_cpl_timeout]
    parameters : [CPL_TIMEOUT_CYCLES=64]
    toplevel : [tb_tlp_request_tracker]

  # ---- Completion Timeout: the DEFAULT value (no override) ------------------
  verilate_tlp_cpl_timeout_default:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_cpl_timeout_default
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_request_tracker, cocotb_cpl_timeout_default]
    toplevel : [tb_tlp_request_tracker]

  # ---- sec 63 #7g-2 Phase 1 -- NOT A GATE ROW ---------------------------------
  # Where the shipped 6250 actually fires, across all 32 round-robin scan
  # phases, on the bench copy AND dut_default_witness.  No `parameters:` entry
  # -- the same elaboration as verilate_tlp_cpl_timeout_default.
  #   fusesoc run --target=measure_7g2_cpl_sweep fusesoc:pcie:tb_tlp
  measure_7g2_cpl_sweep:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_7g2_cpl_sweep
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_request_tracker, cocotb_7g2_sweep]
    toplevel : [tb_tlp_request_tracker]

  # ---- Completion Timeout DISABLED: CPL_TIMEOUT_CYCLES=0 --------------------
  # T7.  Re-runs the UNMODIFIED tracker bench module.  With the mechanism off
  # the RTL must behave exactly as it did before it existed, so this target's
  # results and total sim time must match verilate_tlp_request_tracker to the ns.
  verilate_tlp_cpl_timeout_off:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_request_tracker
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_request_tracker, cocotb_request_tracker]
    parameters : [CPL_TIMEOUT_CYCLES=0]
    toplevel : [tb_tlp_request_tracker]

  # ---- VC0 flow control: tlp_credit_manager as the DUT ----------------------
  # tlp_credit_manager (instantiated at tlp_layer.sv:474) supplies the
  # credit_request_ready that gates vc_packet_ready at tlp_layer.sv:280, so it
  # sits on the TX critical path -- and until now every FuseSoC harness
  # advertised maximum credits (the RC1 fix, 7d471e0) and never approached a
  # limit, leaving its exhaustion logic covered only incidentally.  The bundled
  # bench is the one place a credit pool is actually driven to zero: it loads a
  # short FC update, spends a posted request's data credits exactly, checks the
  # resulting block, and proves the posted/non-posted/completion pools are
  # independent.  Wiring only -- the RTL is untouched by this target.
  verilate_tlp_credit_manager:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_credit_manager
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_credit_manager, cocotb_credit_manager]
    toplevel : [tb_tlp_credit_manager]

  # ---- Flow-control gating at the layer level -------------------------------
  # No SV wrapper -- drives tlp_layer's real fc_* / command_* ports directly and
  # watches what actually reaches the DLL AXIS port.
  verilate_tlp_credit_integration:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_credit_integration
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_credit_integration]
    toplevel : [tlp_layer]

  # ---- VC0 store-and-forward packet buffer ---------------------------------
  # tlp_vc_buffer (instantiated once at tlp_layer.sv:455 as vc_buffer_inst) is
  # the last TL module whose bundled bench had never been run: tb_tlp_vc_buffer.sv
  # and test_tlp_vc_buffer.py shipped with the inherited RTL but were wired into
  # no target, so nothing under src/tlp/tlp_vc_buffer.sv had ever executed
  # standalone.  It is a packet-granular FIFO -- PACKET_DEPTH whole TLPs, each up
  # to MAX_PACKET_WORDS words -- so its contract is packet atomicity (a TLP is
  # visible downstream only after its last beat lands), credit metadata latched
  # at the first beat, and ordinary AXIS backpressure rather than overflow when
  # the packet FIFO is full.  The wrapper narrows PACKET_DEPTH to 2 and
  # MAX_PACKET_WORDS to 16 so a full-buffer and a maximum-length packet are both
  # reachable in a short sim.  Wiring only -- the RTL is untouched by this target.
  verilate_tlp_vc_buffer:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_vc_buffer
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_vc_buffer, cocotb_vc_buffer]
    toplevel : [tb_tlp_vc_buffer]

  # ---- The same buffer at a NON-power-of-two geometry -----------------------
  # PACKET_DEPTH=3, MAX_PACKET_WORDS=5.  The slot pointers are $clog2(DEPTH) bits
  # wide (tlp_vc_buffer.sv:46), so at DEPTH 2 or 4 they wrap on their own width
  # and the explicit `== PACKET_DEPTH-1` wrap (:96, :110) is unobservable -- an
  # off-by-one there is invisible at every power-of-two depth.  At DEPTH=3 the
  # pointer is two bits but must wrap at 2, so the ternary is load-bearing.  A
  # non-power-of-two word bound likewise makes `wr_word_r < MAX_PACKET_WORDS` a
  # real comparison, which is the case the shipped instance is in: tlp_layer.sv
  # :455 overrides PACKET_DEPTH only and leaves MAX_PACKET_WORDS at 1030.
  verilate_tlp_vc_buffer_wrap:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_vc_buffer_wrap
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, bench_vc_buffer, cocotb_vc_buffer_wrap]
    parameters : [PACKET_DEPTH=3, MAX_PACKET_WORDS=5]
    toplevel : [tb_tlp_vc_buffer]

  # ---- The stranded end-to-end suite, wired for the first time ----
  # Drives tlp_layer's own ports and loops its TX wire back into its RX wire, so
  # generator and parser are checked against each other across all six request
  # families, the optional packet sections (prefix / ECRC / unaligned BE), the
  # 1024-DW maximum length, tag retirement, and the six malformed-TLP codes.
  #
  # Same shape as verilate_tlp_compile: no bench .sv, toplevel is the RTL module
  # itself.  No --timing -- that is a src/dllp requirement and this is TL-only.
  verilate_tlp_end_to_end:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_tlp_end_to_end
      timescale: 1ns/1ns
      verilator_options:
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl, cocotb_end_to_end]
    toplevel : [tlp_layer]

parameters:
  PACKET_DEPTH:
    datatype: int
    default: 2
    description: >
      Whole TLPs the tlp_vc_buffer bench instance can hold.  Only the
      non-power-of-two target overrides it; see verilate_tlp_vc_buffer_wrap.
    paramtype: vlogparam
  MAX_PACKET_WORDS:
    datatype: int
    default: 16
    description: >
      Longest packet in words the tlp_vc_buffer bench instance accepts before it
      backpressures and raises overflow_o.
    paramtype: vlogparam
  CPL_TIMEOUT_CYCLES:
    datatype: int
    default: 4096
    description: >
      Cycles a tag may stay outstanding before tlp_request_tracker times it out.
      0 disables the Completion Timeout mechanism entirely.
    paramtype: vlogparam
