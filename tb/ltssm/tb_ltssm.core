CAPI=2:
name: fusesoc:pcie:tb_ltssm:1.0.0
description: pcie link training state machine

filesets:
  rtl:
    depend:
      - fusesoc:pcie:ltssm

  cocotb:
    files:
      - pcie_ltssm/tb/test_ltssm_configuration.py : {file_type : user, copyto : .}

  cocotb_linkup:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_linkup.py : {file_type : user, copyto : .}

  cocotb_recovery:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_recovery.py : {file_type : user, copyto : .}

  cocotb_detect_retry:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_detect_retry.py : {file_type : user, copyto : .}

  cocotb_polling_timeout:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_timeout.py : {file_type : user, copyto : .}

  cocotb_polling_timeout_tx_ok:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_timeout_tx_ok.py : {file_type : user, copyto : .}

  cocotb_config_timeout:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_config_timeout.py : {file_type : user, copyto : .}

  cocotb_partial_lanes:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_partial_lanes.py : {file_type : user, copyto : .}

  cocotb_recovery_partial_lanes:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_partial_lanes.py : {file_type : user, copyto : .}
      - test_ltssm_recovery_partial_lanes.py : {file_type : user, copyto : .}

  cocotb_polling_p4:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_p4.py : {file_type : user, copyto : .}

  cocotb_cfgidle_c26a:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_cfgidle_c26a.py : {file_type : user, copyto : .}

  cocotb_detect_d7:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_detect_d7.py : {file_type : user, copyto : .}

  cocotb_ltssm_l0:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_l0.py : {file_type : user, copyto : .}

  cocotb_ltssm_ridle:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_ridle.py : {file_type : user, copyto : .}

  cocotb_ltssm_obs:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_obs.py : {file_type : user, copyto : .}

  cocotb_recovery_skew:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_recovery_skew.py : {file_type : user, copyto : .}

  cocotb_ltssm_a3:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_a3.py : {file_type : user, copyto : .}

  cocotb_polling_p3:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_p3.py : {file_type : user, copyto : .}

  cocotb_config_c8:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_config_c8.py : {file_type : user, copyto : .}

  cocotb_config_conforms:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_config_conforms.py : {file_type : user, copyto : .}

  cocotb_polling_p11:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_p11.py : {file_type : user, copyto : .}

  cocotb_polling_p12:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_polling_p12.py : {file_type : user, copyto : .}

  cocotb_x4_oracles:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_x4_oracles.py : {file_type : user, copyto : .}

  cocotb_config_gaps:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_config_gaps.py : {file_type : user, copyto : .}

  cocotb_ltssm_24ms:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_24ms.py : {file_type : user, copyto : .}

  cocotb_rc_linkup:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_rc_linkup.py : {file_type : user, copyto : .}

  rtl_b2b:
    files:
      - tb_ltssm_b2b.sv : {file_type : systemVerilogSource}
    depend:
      - fusesoc:pcie:ltssm

  cocotb_b2b:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_b2b.py : {file_type : user, copyto : .}

  cocotb_b2b_x4:
    files:
      - ltssm_tb_common.py : {file_type : user, copyto : .}
      - test_ltssm_b2b_x4.py : {file_type : user, copyto : .}

targets:
  default:
    flow: sim
    flow_options:
      tool : icarus
      iverilog_options:
        - -g2012 -DCOCOTB_SIM # Use SystemVerilog-2012
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
    filesets : [rtl,cocotb]
    toplevel : [dllp_receive]
  
  sim:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -j 4
        - waiver.vlt
      vlogan_options:
        - -Wno-NTSFM -timescale=1ns/1ps +acc +vpd
      vcs_options:
        - +vcs+dumpvars+test.vcd
    filesets : [rtl,cocotb]
    toplevel : [pcie_phy_top]

  verilate:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - waiver.vlt
    filesets : [rtl,cocotb]
    toplevel : [pcie_ltssm_downstream]

  verilate_fast:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_linkup
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_linkup]
    toplevel : [pcie_ltssm_downstream]

  verilate_recovery:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_recovery
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_recovery]
    toplevel : [pcie_ltssm_downstream]

  # Back-to-back RC<->EP link-up: two LTSSM instances in tb_ltssm_b2b.sv,
  # IS_ROOT_PORT set per-instance inside the harness. x1.
  verilate_b2b:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_b2b
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - --public-flat-rw
        - waiver.vlt
    filesets : [rtl_b2b,cocotb_b2b]
    toplevel : [tb_ltssm_b2b]

  # Back-to-back at x4: RC assigns Lane Numbers 0-3, EP echoes. Asserts the
  # per-lane assignment content, not just L0. --public-flat-rw exposes the
  # genvar-scoped counters for the per-lane hang dump.
  verilate_b2b_x4:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_b2b_x4
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=4
        - --public-flat-rw
        - waiver.vlt
    filesets : [rtl_b2b,cocotb_b2b_x4]
    toplevel : [tb_ltssm_b2b]

  # Root-Complex-mode link-up: DUT is the RC (IS_ROOT_PORT=1), x1 link,
  # LINK_NUM=1. First target to exercise the IS_ROOT_PORT=1 DUT behavior.
  verilate_rc_linkup:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_rc_linkup
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_rc_linkup]
    toplevel : [pcie_ltssm_downstream]

  verilate_detect_retry:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_detect_retry
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_detect_retry]
    toplevel : [pcie_ltssm_downstream]

  verilate_polling_timeout:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_timeout
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_timeout]
    toplevel : [pcie_ltssm_downstream]

  verilate_polling_timeout_tx_ok:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_timeout_tx_ok
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_timeout_tx_ok]
    toplevel : [pcie_ltssm_downstream]

  verilate_config_timeout:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_config_timeout
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_config_timeout]
    toplevel : [pcie_ltssm_downstream]

  verilate_partial_lanes:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_partial_lanes
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_partial_lanes]
    toplevel : [pcie_ltssm_downstream]

  verilate_recovery_partial_lanes:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_recovery_partial_lanes
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - waiver.vlt
    filesets : [rtl,cocotb_recovery_partial_lanes]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle P4: WHEN the "1024 TS1 transmitted" limb must be met.
  # Base 2.1 4.2.6.2.1 p.220 counts it from entry to Polling.Active; the
  # "after receiving one TS1" qualifier on p.221 belongs to the 24 ms branch
  # only. :651 applies it to both. expect_fail row.
  verilate_polling_p4:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_p4
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_p4]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle C26a: how many times Configuration.Idle's 2 ms timeout
  # may divert to Recovery. Base 2.1 4.2.6.3.6 p.237 permits exactly one;
  # :979 compares the whole rate_id_t struct instead of .rate, so the 8'hFF
  # saturation is dead and 255 are admitted. expect_fail row.
  # Long by construction: TwoMsTimeOut is not SIM_FAST_LINK scaled, so each
  # of the two timeouts costs a real 200 000 cycles.
  verilate_cfgidle_c26a:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_cfgidle_c26a
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_cfgidle_c26a]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle D7: Detect.Active's "no Receiver detected" exit. Base 2.1
  # 4.2.6.1.2 p.219 requires Detect.Quiet; :592 goes to ST_IDLE, whose only
  # exit is `if (en_i)`. expect_fail row.
  verilate_detect_d7:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_detect_d7
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_detect_d7]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle P3: Polling.Active never reads TS Symbol 5, so a TS1 with
  # Compliance Receive = 1b and Loopback = 0b -- which qualifies under none of
  # Base 2.1 4.2.6.2.1 p.220's three conditions, and is p.221's
  # Polling.Compliance trigger -- is counted anyway. expect_fail row.
  verilate_polling_p3:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_p3
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_p3]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle C8: Configuration.Linkwidth.Accept adds an
  # `ordered_set_sent_cnt_r >= 8` gate that Base 2.1 4.2.6.3.2.1 p.230 does not
  # state -- the spec's condition is two consecutive matching TS1 alone.
  # expect_fail row.
  verilate_config_c8:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_config_c8
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_config_c8]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b: the predicted-CONFORMS Configuration oracles -- C3, C11, C14, C25.
  # Ordinary PASS rows, not expect_fail. Each ships a negative control that
  # withholds the spec condition and asserts the DUT does NOT advance, so a
  # green result cannot be a tautology.
  verilate_config_conforms:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_config_conforms
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_config_conforms]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle P11 (predicted CONFORMS): Polling.Configuration ->
  # Configuration on 8 consecutive TS2 PAD/PAD plus 16 transmitted after
  # receiving one. Negative control: a non-PAD Link must not advance it.
  verilate_polling_p11:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_p11
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_p11]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b / oracle P12 (predicted CONFORMS): Polling.Configuration's 48 ms
  # timeout to Detect, bracketed from both sides so the constant is pinned
  # rather than merely observed.
  # EXPENSIVE BY CONSTRUCTION: FourtyEightMsTimeOut is not SIM_FAST_LINK
  # scaled, so this row runs a real 4.8 M cycles (~8 min). Own target so the
  # cost is visible per-row.
  verilate_polling_p12:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_polling_p12
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_polling_p12]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b: the oracles that only exist at x4 -- D9/D10 (ST_DETECT_RX is
  # structurally unreachable at x1), the |-vs-& reduction at :660 (an
  # equivalent mutant at x1; this discharges Rung 1 LTSSM_ARCS.md section 6.3,
  # which required a test that is x4 AND in the gate), and per-lane Lane Number
  # assignment (a documented no-op at x1, :2004-2006).
  verilate_ltssm_x4_oracles:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_x4_oracles
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=4
        - waiver.vlt
    filesets : [rtl,cocotb_x4_oracles]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b: four cheap Configuration/Polling gaps -- C18 (the data rate
  # identifier limb is never compared), C9 and C16 (the spec's non-timeout
  # exits to Detect are absent, and C16's substate has no spec timeout at all
  # yet the RTL adds one), and P9 (polarity inversion lives in Polling.Active,
  # not Polling.Configuration where p.224 places the requirement). All four
  # expect_fail; P9 carries a positive control.
  verilate_config_gaps:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_config_gaps
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GIS_ROOT_PORT=1
        - -GLINK_NUM=1
        - -GMAX_NUM_LANES=1
        - waiver.vlt
    filesets : [rtl,cocotb_config_gaps]
    toplevel : [pcie_ltssm_downstream]

  # Rung 10b: the two oracles behind the unscaled 24 ms watchdog.
  # D11 characterises Detect.Active's extra-spec timeout (Base 2.1 p.219 gives
  # the substate none) and brackets the constant; P6 shows the 24 ms
  # Polling.Active branch ignores p.221's Electrical-Idle-exit limb.
  # EXPENSIVE BY CONSTRUCTION: TwentyFourMsTimeOut is not SIM_FAST_LINK scaled,
  # so each test runs a real 2.4 M cycles. x4 -- P6 is vacuous at x1 because
  # its premise is that the primary exit at :660 is blocked.
  verilate_ltssm_24ms:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_24ms
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=4
        - waiver.vlt
    filesets : [rtl,cocotb_ltssm_24ms]
    toplevel : [pcie_ltssm_downstream]

  verilate_ltssm_l0:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_l0
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=4
        - waiver.vlt
    filesets : [rtl,cocotb_ltssm_l0]
    toplevel : [pcie_ltssm_downstream]

  verilate_ltssm_ridle:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_ridle
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=4
        - waiver.vlt
    filesets : [rtl,cocotb_ltssm_ridle]
    toplevel : [pcie_ltssm_downstream]

  # Fix-arc 1 / defect register #2 (FINDINGS_LTSSM.md section 2, B1+B2):
  # error_o and success_o are declared and never driven, which also makes the
  # four error_o assertions on rows 58/63 tautologies.  x4 because the cheapest
  # reachable error_c site is :614 in ST_DETECT_RX, and ST_DETECT_RX is
  # unreachable at x1 (|receiver_detected_i and &receiver_detected_i coincide).
  # 2 expect_fail rows plus 1 control.
  # Fix-arc 2 / MG1+MG2 closure: the ONLY bench where lane_active_r and
  # receiver_detected_i diverge WHILE traversing Recovery.  Every reader of
  # ts2_cnt_satisfied is in a Recovery state, and the one pre-existing bench
  # with a divergent mask (verilate_ltssm_x4_oracles) never enters Recovery --
  # so before this target the lane_active_r-vs-receiver_detected_i gate choice
  # at :1613, and :1269's choice of operand, were both untested.  x4, because
  # the skew needs at least two lanes to exist at all.  2 ordinary PASS rows.
  verilate_recovery_skew:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_recovery_skew
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=4
        - waiver.vlt
    filesets : [rtl,cocotb_recovery_skew]
    toplevel : [pcie_ltssm_downstream]

  verilate_ltssm_obs:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_obs
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=4
        - waiver.vlt
    filesets : [rtl,cocotb_ltssm_obs]
    toplevel : [pcie_ltssm_downstream]

  verilate_ltssm_a3:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_a3
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - -GCLK_PERIOD_NS=8    # 63 #7g-2 (D-7G.2): the RTL period, stated by the bench; the test's Clock() uses the same CLK_PERIOD_NS
        - -GSIM_FAST_LINK=1
        - -GMAX_NUM_LANES=4
        - waiver.vlt
    filesets : [rtl,cocotb_ltssm_a3]
    toplevel : [pcie_ltssm_downstream]

  synth:
    default_tool : vivado
    filesets : [rtl]
    tools:
      vivado:
        part : xczu5ev-sfvc784-1-e
    toplevel : pcie_phy_top

scripts:
  iceprog:
    cmd : [MODULE=pcie_ltssm_downstream]