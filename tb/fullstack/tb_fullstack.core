CAPI=2:

name: fusesoc:pcie:tb_fullstack:1.0.0
description: >
  SS63 #7b -- the full-stack RC<->EP bench and its codec bridge.

  This is a SEPARATE core from tb_rc and tb_rc_ep deliberately. tb_rc_ep carries
  the RC<->EP bench at the AXIS packet seam, where neither stack has a PHY;
  this core carries the bench at the PIPE symbol seam, where BOTH do. Folding
  them together would make the AXIS-seam bench pull in the LTSSM, both logical
  PHYs and the 8b/10b codec for a composition it does not build.

  !! THE BRIDGE IS BENCH INFRASTRUCTURE AND LIVES HERE, NOT IN src/. Nothing on
  either stack's boundary changes to accommodate it. On real hardware the thing
  in this position is a transceiver.

filesets:
  bridge:
    files:
      - pipe_codec_bridge.sv
      - tb_pipe_codec_bridge.sv
    file_type: systemVerilogSource
    depend:
      # The codecs themselves. phy_scrambler is the only core that carries
      # encode_8b10b/decode_8b10b, and it brings its own packages/axis/lint.
      - fusesoc:pcie:phy_scrambler:1.0.0
      - fusesoc:pcie:lint

  cocotb_bridge:
    files:
      - test_pipe_codec_bridge.py : {file_type : user, copyto : .}

  # The full stack: our RC vertical, Joy's EP vertical, and the bridge.
  #
  # !! ::rc_top_core CARRIES pcie_phy_top.sv DIRECTLY RATHER THAN VIA phy_core,
  # and that is load-bearing here too: phy_core's rtl fileset also carries
  # example/pcie_top.v, which instantiates pcie_phy_top without naming every
  # pin, so depending on it drags an incomplete instantiation site into the
  # build and turns D-FS.1's seven outputs into seven PINMISSING warnings that
  # have nothing to do with this bench. Measured at SS63 #7a, inherited here.
  fullstack:
    files:
      - tb_pcie_fullstack.sv
    file_type: systemVerilogSource
    depend:
      - ::rc_top_core:1.0.0
      - fusesoc:pcie:endpoint_protocol:1.0.0
      - fusesoc:pcie:lint

  cocotb_fullstack:
    files:
      - test_pcie_fullstack.py : {file_type : user, copyto : .}

  # SS63 #7d Phase 1: the measurement probe, attached by `bind`. Its own fileset
  # and its own target so that verilate_fullstack -- a gate row -- is byte-for-byte
  # unchanged by a measurement. A probe that perturbs the row it measures is not a
  # measurement of that row.
  probe_7d:
    files:
      - probe_7d.sv
    file_type: systemVerilogSource

  # §63 #7d probe phase: the FC-init blocker. Same rule -- own fileset, own
  # target, verilate_fullstack untouched.
  probe_7de:
    files:
      - probe_7de.sv
    file_type: systemVerilogSource

  # §63 #7e Phase 1: F17 -- the CfgRd0 measured at five stages. Same rule again.
  probe_7e:
    files:
      - probe_7e.sv
    file_type: systemVerilogSource

  # §63 #7f Phase 1: F18 instrument 1-L -- the latency ladder. Same rule again.
  probe_7f:
    files:
      - probe_7f.sv
    file_type: systemVerilogSource

  # sec 63 #7h Phase 1 instrument 1-e -- the raw PIPE TX window.  Own fileset
  # and own target: probe_7f.sv stays byte-identical so no #7f row moves.
  probe_7h:
    files:
      - probe_7h.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - bridge

  # ---------------------------------------------------------------------------
  # The bridge ALONE, B side looped back. Four probe rows: round trip, K flag
  # with a negative control, running-disparity bound at the wire, and
  # valid-gating checked differentially.
  #
  # !! THIS TARGET RUNS BEFORE THE BRIDGE TOUCHES A DUT. A codec bug found here
  # costs a 3-second run; the same bug found inside the full-stack bench reads
  # as "the Endpoint does not train".
  # ---------------------------------------------------------------------------
  verilate_pipe_bridge:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_pipe_codec_bridge
      timescale: 1ns/1ps
      verilator_options:
        - --timing
        - waiver.vlt
    filesets : [bridge, cocotb_bridge]
    toplevel : [tb_pipe_codec_bridge]

  # ---------------------------------------------------------------------------
  # Elaboration-only, for the integration site itself -- this is where a missing
  # pin shows up, with no bench in the way. Not a gate row.
  #
  # !! INVOKE WITH --build, NOT A BARE run:
  #       fusesoc run --build --target=lint_fullstack fusesoc:pcie:tb_fullstack
  # In lint-only mode there is no executable, so the sim flow's run stage raises
  # `TypeError: cannot unpack non-iterable NoneType object` AFTER a completely
  # successful lint. A bare `fusesoc run` therefore reports rc=1 on a clean
  # elaboration -- the inverse of the usual trap, and just as misleading.
  # ---------------------------------------------------------------------------
  lint_fullstack:
    flow: sim
    flow_options:
      tool: verilator
      mode: lint-only
      timescale: 1ns/1ps
      verilator_options:
        - --timing
        - waiver.vlt
    filesets: [bridge, fullstack]
    toplevel: [tb_pcie_fullstack]

  # ---------------------------------------------------------------------------
  # Rows 1-5: the full stack against Joy's Endpoint through the codec bridge.
  # ---------------------------------------------------------------------------
  verilate_fullstack:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_pcie_fullstack
      timescale: 1ns/1ps
      verilator_options:
        - --timing
        - waiver.vlt
    filesets : [bridge, fullstack, cocotb_fullstack]
    toplevel : [tb_pcie_fullstack]

  # ---------------------------------------------------------------------------
  # SS63 #7d Phase 1 -- NOT A GATE ROW. verilate_fullstack plus probe_7d.sv.
  # Runs the same cocotb module against the same stack; the probe adds only
  # bind-attached observers and prints PR7D_* lines from a `final` block.
  #
  #   fusesoc run --build --target=verilate_fullstack_probe7d fusesoc:pcie:tb_fullstack
  # ---------------------------------------------------------------------------
  verilate_fullstack_probe7d:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_pcie_fullstack
      timescale: 1ns/1ps
      verilator_options:
        - --timing
        - waiver.vlt
    filesets : [bridge, fullstack, cocotb_fullstack, probe_7d]
    toplevel : [tb_pcie_fullstack]

  # ---------------------------------------------------------------------------
  # §63 #7d probe phase -- NOT A GATE ROW. The FC-init blocker probes (E1-E3).
  #   fusesoc run --target=verilate_fullstack_probe7de fusesoc:pcie:tb_fullstack
  # ---------------------------------------------------------------------------
  verilate_fullstack_probe7de:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_pcie_fullstack
      timescale: 1ns/1ps
      verilator_options:
        - --timing
        - waiver.vlt
    filesets : [bridge, fullstack, cocotb_fullstack, probe_7de]
    toplevel : [tb_pcie_fullstack]

  # ---------------------------------------------------------------------------
  # §63 #7e Phase 1 -- NOT A GATE ROW. F17: the CfgRd0 measured at five stages,
  # both stacks, in ONE elaboration. Every bind fires twice (RC and EP) and %m
  # says which.
  #   fusesoc run --target=verilate_fullstack_probe7e fusesoc:pcie:tb_fullstack
  # ---------------------------------------------------------------------------
  verilate_fullstack_probe7e:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_pcie_fullstack
      timescale: 1ns/1ps
      verilator_options:
        - --timing
        - waiver.vlt
    filesets : [bridge, fullstack, cocotb_fullstack, probe_7e]
    toplevel : [tb_pcie_fullstack]

  # ---------------------------------------------------------------------------
  # §63 #7f Phase 1 -- NOT A GATE ROW. F18 instrument 1-L: the latency ladder.
  # Eleven stage boundaries from the DLL's TX AXIS out to the far DLL's RX AXIS
  # in, both stacks in ONE elaboration. Every bind fires at both and %m says
  # which; the scrambler binds fire four times (TX and RX of each stack).
  #
  # Emits PR7F_L event lines AT the event with $time -- no cumulative `final`
  # counters (#7e's withdrawn-claim lesson) -- plus PR7F_LSUM disclosing what
  # each stamper suppressed.
  #   fusesoc run --target=verilate_fullstack_probe7f fusesoc:pcie:tb_fullstack
  # ---------------------------------------------------------------------------
  verilate_fullstack_probe7f:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_pcie_fullstack
      timescale: 1ns/1ps
      verilator_options:
        - --timing
        - waiver.vlt
    filesets : [bridge, fullstack, cocotb_fullstack, probe_7f]
    toplevel : [tb_pcie_fullstack]

  # sec 63 #7h Phase 1, instrument 1-e.  verilate_fullstack is UNTOUCHED; this
  # is a separate target carrying probe_7h.sv, which logs every cycle -- valid
  # or not -- at phy_transmit's PIPE TX output for a 1400-cycle span opened by
  # the first STP.  That is the seam D-7H.4(a) is stated about, and "what the
  # non-packet cycles carry" (H7H-5) cannot be answered by a valid-gated probe.
  verilate_fullstack_probe7h:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_pcie_fullstack
      timescale: 1ns/1ps
      verilator_options:
        - --timing
        - waiver.vlt
    filesets : [bridge, fullstack, cocotb_fullstack, probe_7h]
    toplevel : [tb_pcie_fullstack]
