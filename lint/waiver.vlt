/*
 *  ---------------------------------------------------------------------------
 *  5. UNOPTFLAT -- circular combinational logic.  NINE sites, the exact set the
 *     gate invocation emits (#7g-3 census, all 110 targets, .vc verbatim).
 *     MEASURED at #7g-3 (ruling #6) with --report-unoptflat: every one is a
 *     Verilator FALSE POSITIVE -- the cycle closes only at variable or
 *     always-block granularity, never bit for bit -- and the routed RC top has
 *     no LUTLP-1 (combinational loop) DRC.  0 defects; the reason is per line.
 *
 *  ⚠️⚠️ THESE SITES WERE MEASURED WRONG THE FIRST TIME AND IT ABORTED A GATE.
 *  UNOPTFLAT is a SCHEDULING warning, not a lint one.  The first census ran
 *  `verilator --lint-only`, which never performs the ordering analysis, and
 *  reported two sites -- `gen1_scramble.sv:25` and `ordered_set_handler.sv:100`
 *  -- neither of which the real build emits.  A second attempt used `--cc` but
 *  stripped `--public-flat-rw` and `--vpi` as "cocotb linkage"; it reported
 *  none at all.  `--public-flat-rw` is precisely the flag that blocks the
 *  optimisation whose absence is reported, so stripping it removed the warnings
 *  the census existed to find.  Every core is warnings-fatal (the Verilator
 *  default; no core passes -Wno-fatal), so the six builds carrying these sites
 *  died on sites no measurement had ever shown.
 *
 *  ⚠️ AND THE REBUILT LIST WAS WRONG TOO, FOR A SECOND AND DIFFERENT REASON:
 *  it was derived from a THREE-TARGET smoke, which does not contain
 *  `ordered_set_handler.sv:100` -- real on six targets.  Re-derived from the
 *  union over all 110.  A list rebuilt from a sample is a sample, not a list.
 *
 *  ⭐ THE RULE, and it generalises past this file: MEASURE WITH THE INVOCATION
 *  UNDER TEST, OVER THE WHOLE SET.  The fusesoc-generated .vc is used VERBATIM now -- not sed'd,
 *  not simplified, not "cleaned up".  `verify_waiver.sh` copies it.
 *  ---------------------------------------------------------------------------
 */
lint_off -rule UNOPTFLAT -file "*/dllp2tlp.sv" -lines 162   // false positive: main_combo reads crc_output_* only into crc_calculated_c (a register)
lint_off -rule UNOPTFLAT -file "*/gen1_scramble.sv" -lines 24   // false positive: lfsr_out[i] -> temp_lfsr_in[i] -> lfsr_out[i+1], an i->i+1 array chain
lint_off -rule UNOPTFLAT -file "*/ordered_set_handler.sv" -lines 100   // false positive: byte_shift = pipe_width_i>>3, never from pkt_full (Joy/Idris)
lint_off -rule UNOPTFLAT -file "*/pcie_endpoint_top.sv" -lines 484   // false positive: tx running disparity, symbol k -> k+1 in one word (Joy)
lint_off -rule UNOPTFLAT -file "*/pcie_endpoint_top.sv" -lines 485   // false positive: rx running disparity, symbol k -> k+1 in one word (Joy)
lint_off -rule UNOPTFLAT -file "*/pipe_codec_bridge.sv" -lines 277   // false positive: bench encoder disparity, symbol k -> k+1
lint_off -rule UNOPTFLAT -file "*/pipe_codec_bridge.sv" -lines 278   // false positive: bench decoder disparity, symbol k -> k+1
lint_off -rule UNOPTFLAT -file "*/priority_encoder.v" -lines 53   // false positive: vendored encoder tree, level n from n-1
lint_off -rule UNOPTFLAT -file "*/priority_encoder.v" -lines 54   // false positive: vendored encoder tree, level n from n-1

