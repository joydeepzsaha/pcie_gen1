/*
 *  ---------------------------------------------------------------------------
 *  8. WIDTHEXPAND -- per FILE.  Zero-extension of a narrower RHS is
 *     VALUE-PRESERVING by construction, so this class cannot lose information.
 *     Per file, not per site: 182 ours-sites of parameter-literal and counter
 *     arithmetic, and a 182-line per-site list would itself become the next
 *     copied list.  A new WIDTHTRUNC in these files still reaches the narrow.
 *  ---------------------------------------------------------------------------
 */
lint_off -rule WIDTHEXPAND -file "*/axis_retry_fifo.sv"   // value-preserving zero-extension
lint_off -rule WIDTHEXPAND -file "*/block_alignment.sv"   // value-preserving zero-extension
/*
 *  §63 #7g-3: THE FENCE HOLE IS CLOSED.  Three design-wide
 *  `-file "<star>" -match` entries stood here, because a `-file` waiver naming
 *  data_handler.sv suppressed nothing (the #7g-1 anomaly, still UNEXPLAINED)
 *  and the warnings could not be left visible.  The eleven sites behind them
 *  are fixed at the source instead -- explicit |data_valid_i, 32-bit
 *  word_count_r arithmetic, zero-padded concatenations -- and the three entries
 *  and the three per-site data_handler entries (which never worked) are
 *  deleted.  data_handler.sv now has no -lines or rule-only entry here; its
 *  per-file entries in section 9 are -match entries, which are message-matched
 *  and DO work.  Do not re-add a design-wide -file "<star>" entry: fix the site.
 *
 *  ⚠️ CORRECTION to the #7g-1 record: EVERY gate core is warnings-fatal, not
 *  six.  No core passes -Wno-fatal and fatal-on-warning is the Verilator
 *  default; six died at #7g-1 because six carried visible warnings.  A warning
 *  anywhere in any gate target is a crashed build.
 *
 *  ⚠️ NO APOSTROPHES IN A `-match` PATTERN.  Verilator's .vlt lexer treats the
 *  apostrophe as the start of a based literal even inside a double-quoted
 *  string, so such a pattern fails with Unterminated string and takes the whole
 *  file with it.  Wildcard around quoted signal names instead.
 */
lint_off -rule WIDTHEXPAND -file "*/dllp_fc_update.sv"   // value-preserving zero-extension
lint_off -rule WIDTHEXPAND -file "*/dllp_handler.sv"   // value-preserving zero-extension
lint_off -rule WIDTHEXPAND -file "*/dllp_receive.sv"   // value-preserving zero-extension
lint_off -rule WIDTHEXPAND -file "*/dllp_transmit.sv"   // value-preserving zero-extension
lint_off -rule WIDTHEXPAND -file "*/frame_symbols.sv"   // value-preserving zero-extension
lint_off -rule WIDTHEXPAND -file "*/gen1_scramble.sv"   // value-preserving zero-extension
lint_off -rule WIDTHEXPAND -file "*/lane_management.sv"   // value-preserving zero-extension
lint_off -rule WIDTHEXPAND -file "*/ordered_set_handler.sv"   // value-preserving zero-extension
lint_off -rule WIDTHEXPAND -file "*/os_generator.sv"   // value-preserving zero-extension
