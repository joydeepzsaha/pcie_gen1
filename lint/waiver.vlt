`verilator_config
/*
 *  ===========================================================================
 *   Verilator lint waiver -- REWRITTEN at Sec63 #7g-1 (2026-09-23) from a
 *   measured, per-site census of all 109 gate targets.  Evidence and the
 *   per-group rulings: pcie_docs evidence/cleanup-7g/REPORT_7G1_WAIVER_CENSUS.md
 *
 *   WHAT CHANGED, AND WHY IT MATTERS
 *   The previous file was 14 bare `lint_off -rule X` lines.  That suppressed
 *   100% of Verilator static output across every target: 4,771 warnings at 328
 *   sites, and `.diag.narrow` had never carried a single lint line in its life.
 *   Nine of those 14 lines suppressed NOTHING (six fire nowhere at all; three
 *   are -Wall-only) -- the list was copied, not curated.
 *
 *   THE FENCE THIS BUYS: every suppression below is scoped to a FILE (with the
 *   warning class named via -match) or to a SITE (-lines).  A new lint site
 *   anywhere in the design now REACHES `.diag.narrow` instead of vanishing.
 *   That is the whole point; do not re-broaden a rule to silence a new warning.
 *
 *   DELETED, because they fire nowhere (census, Verilator 5.050):
 *     WIDTH           -- legacy: Verilator 5 split it into WIDTHEXPAND/WIDTHTRUNC,
 *                        so the bare name matches nothing.  A pure no-op.
 *     UNSIGNED, ASCRANGE, MULTIDRIVEN, MODDUP, IMPLICIT -- 0 occurrences.
 *     PINCONNECTEMPTY, UNUSEDSIGNAL, UNUSEDPARAM -- -Wall-only; the gate does
 *                        not pass -Wall, so waiving them suppressed nothing.
 *   Predicted at Sec63 #7g-1: deleting all nine changes NO artifact byte.
 *  ===========================================================================
 */

/*
 *  ---------------------------------------------------------------------------
 *  1. REGISTERED ITEMS -- waived per SITE so the narrow stays a fence, each
 *     naming its ticket.  The waiver is a noise policy; the REGISTER is the
 *     memory.  #7g-3 fixed and DELETED the tlp2dllp (six port connections)
 *     and pcie_phy_top:380 entries; what remains is item 3, waived with its
 *     measured reason (see the NOTE at the end of this file).
 *  ---------------------------------------------------------------------------
 */
lint_off -rule WIDTHTRUNC -file "*/pcie_cfg_wrapper.sv" -lines 247   // #7g-1 item 3: CF8 addr 32->9; measured max offset 0x24 < 0x200, see note below
lint_off -rule WIDTHTRUNC -file "*/pcie_cfg_wrapper.sv" -lines 258   // #7g-1 item 3: CF8 addr 32->9; measured max offset 0x24 < 0x200, see note below

/*
 *  lane_management: data_valid_r is 4 bits used as a 1-bit condition -- same
 *  shape as data_handler, registered as a candidate at #7g-1.
 */
lint_off -rule WIDTHTRUNC -file "*/lane_management.sv" -lines 711   // #7g-1 candidate -> 7g-3 (data_valid_r)
lint_off -rule WIDTHTRUNC -file "*/lane_management.sv" -lines 712   // #7g-1 candidate -> 7g-3 (data_valid_r)

/*
 *  ---------------------------------------------------------------------------
 *  2. LTSSM per-lane vectors in 1-bit contexts -- an implicit OR-reduce where
 *     the arc may intend ALL lanes.  At x1 ANY == ALL, so these are correct as
 *     built and become live questions only at x2/x4.  Registered as candidates
 *     for the multi-lane rung (ruling #4); same family as Sec54 |-vs-& and
 *     Rung 10c ANY-vs-ALL at :1441/:1246.
 *  ---------------------------------------------------------------------------
 */
lint_off -rule WIDTHTRUNC -file "*/pcie_ltssm_downstream.sv" -lines 1517   // x1: ANY==ALL -> multi-lane rung (ts1_cnt_satisfied)
lint_off -rule WIDTHTRUNC -file "*/pcie_ltssm_downstream.sv" -lines 1532   // x1: ANY==ALL -> multi-lane rung (ts1_cnt_satisfied)
lint_off -rule WIDTHTRUNC -file "*/pcie_ltssm_downstream.sv" -lines 1582   // x1: ANY==ALL -> multi-lane rung (at_least_one_ts1_ts2)
lint_off -rule WIDTHTRUNC -file "*/pcie_ltssm_downstream.sv" -lines 1610   // x1: ANY==ALL -> multi-lane rung (ts1_cnt_satisfied/ts2_cnt_satisfied)
lint_off -rule WIDTHTRUNC -file "*/pcie_ltssm_downstream.sv" -lines 1784   // x1: ANY==ALL -> multi-lane rung (single_idle_received)
lint_off -rule WIDTHTRUNC -file "*/pcie_ltssm_downstream.sv" -lines 1800   // x1: ANY==ALL -> multi-lane rung (at_least_one_ts1_ts2)

/*
