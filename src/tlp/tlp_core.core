CAPI=2:
# tlp_core.core -- core for tlp_layer, the Transaction Layer
#
# Purpose
#   Compiles tlp_layer and every module it instantiates, with tlp_pkg first;
#   tlp_layer is the default target's toplevel. pcie_endpoint.core,
#   rc_core.core and tb/tlp/tb_tlp.core depend on this core.

name: ::tlp_core:1.0.0

filesets:
  rtl:
    files:
      - tlp_pkg.sv
      - tlp_ecrc.sv
      - tlp_validator.sv
      - tlp_classifier.sv
      - tlp_bar_decoder.sv
      - tlp_config_decoder.sv
      - tlp_parser.sv
      - tlp_payload_formatter.sv
      - tlp_request_tracker.sv
      - tlp_requester.sv
      - tlp_completion_generator.sv
      - tlp_control.sv
      - tlp_generator.sv
      - tlp_credit_manager.sv
      - tlp_vc_buffer.sv
      - tlp_layer.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - rtl
    toplevel: tlp_layer
