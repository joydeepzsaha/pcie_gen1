CAPI=2:
# rc_core.core -- core for the Root Complex RTL above the PHY
#
# Author: Kourosh Ghahramani
# Silicon Systems Research Lab, University of Washington
#
# Purpose
#   Provides the PG213-style interface modules (pcie_rq_if, pcie_rc_if,
#   pcie_cq_if, pcie_cc_if, and the two width gearboxes they instantiate)
#   with pcie_rq_rc_top, the enumeration engine (pcie_cfg_txn,
#   pcie_enum_scan, pcie_enum_bar, pcie_enum_bus, pcie_enum_top), their
#   packages pcie_rq_rc_pkg and pcie_enum_pkg, and the Data Link Layer tops
#   pcie_rc_dl_top and pcie_enum_dl_top. tlp_core provides tlp_layer, and
#   dllp_core pcie_datalink_layer. pcie_rc_top, which also needs the LTSSM
#   and the logical PHY, is in rc_top.core.

name: ::rc_core:1.0.0
description: >
  Root Complex RTL above the PHY, with PG213-style host interfaces on the
  Transaction Layer, the enumeration engine and the Data Link Layer tops.

filesets:
  rtl:
    depend:
      - ::tlp_core:1.0.0
      - fusesoc:pcie:dllp_core:1.0.0
      - fusesoc:pcie:lint
    files:
      - pcie_axis_dw_downsize.sv
      - pcie_axis_dw_upsize.sv
      - pcie_rq_rc_pkg.sv
      - pcie_enum_pkg.sv
      - pcie_rq_if.sv
      - pcie_rc_if.sv
      - pcie_cq_if.sv
      - pcie_cc_if.sv
      - pcie_rq_rc_top.sv
      - pcie_rc_dl_top.sv
      - pcie_cfg_txn.sv
      - pcie_enum_scan.sv
      - pcie_enum_bar.sv
      - pcie_enum_bus.sv
      - pcie_enum_top.sv
      - pcie_enum_dl_top.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - rtl
