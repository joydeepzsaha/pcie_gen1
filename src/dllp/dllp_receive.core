CAPI=2:
# dllp_receive.core -- FuseSoC core for the Data Link Layer receive path
#
# Purpose
#   Compiles dllp_receive and the modules it instantiates from this directory
#   (axis_user_demux, dllp_handler, dllp_fc_update, dllp2tlp). The default
#   target names the cocotb module test_dllp_recieve and the iceprog script
#   names dllp_agent; neither exists in the repository.
name: fusesoc:pcie:dllp_receive:1.0.0
description: Data Link Layer receive path (DLLP decode, TLP check, Ack/Nak and UpdateFC)

filesets:
  rtl:
    files:
      - dllp_handler.sv
      - dllp_receive.sv
      - dllp_fc_update.sv
      - dllp2tlp.sv
      - axis_user_demux.sv
    file_type: systemVerilogSource
    depend:
      - fusesoc:pcie:packages
      - fusesoc:pcie:crc
      - fusesoc:pcie:bram
      - fusesoc:pcie:axis
      - fusesoc:pcie:base_uvm
      - fusesoc:pcie:lint
      - fusesoc:pcie:pcie_config


targets:
  default:
    flow: sim
    flow_options:
      tool : icarus
      iverilog_options:
        - -g2012 -DCOCOTB_SIM # Use SystemVerilog-2012
      cocotb_module : test_dllp_recieve
      timescale: 1ns/1ns
    filesets : [rtl]
    toplevel : [dllp_receive]

  synth:
    default_tool : vivado
    filesets : [rtl]
    tools:
      vivado:
        part : xc7a100tcsg324-1
    toplevel : dllp_receive

scripts:
  iceprog:
    cmd : [MODULE=dllp_agent]