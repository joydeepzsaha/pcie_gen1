CAPI=2:
# packages.core -- core for the shared Data Link, PHY and TLP packages
#
# Purpose: pcie_datalink_pkg, pcie_phy_pkg and pcie_tlp_pkg. pcie_tlp_pkg
# imports pcie_datalink_pkg, which is listed before it.
name: fusesoc:pcie:packages:1.0.0
description: PCIe Data Link, PHY and TLP packages

filesets:
  rtl:
    files:
      - pcie_datalink_pkg.sv
      - pcie_phy_pkg.sv
      - pcie_tlp_pkg.sv
    file_type: systemVerilogSource

targets:
  # The "default" target is the one FuseSoC 2.4.6 uses when this core is a
  # dependency or when no target is named.
  # "&default" is a YAML anchor; no alias in this file refers to it.
  default: &default
    filesets:
      - rtl
    toplevel: pcie_datalink_pkg
