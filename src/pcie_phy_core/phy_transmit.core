CAPI=2:
# phy_transmit.core -- FuseSoC core for the physical-layer transmit path
#   phy_transmit with frame_symbols, lane_management and os_generator.
#   synchronous_lifo is listed but nothing instantiates it, and lfsr is
#   instantiated only by synchronous_lifo.
name: fusesoc:pcie:phy_transmit:1.0.0
description: Physical-layer transmit path, DLL stream to PIPE TX

filesets:
  rtl:
    files:
      - lfsr.v
      - synchronous_lifo.sv
      - lane_management.sv
      - frame_symbols.sv
      - os_generator.sv
      - phy_transmit.sv
    file_type: systemVerilogSource
    depend:
      - fusesoc:pcie:packages
      - fusesoc:pcie:phy_scrambler
      - fusesoc:pcie:axis
      - fusesoc:pcie:lint


targets:
  default:
    flow: sim
    flow_options:
      tool : icarus
      iverilog_options:
        - -g2012 -DCOCOTB_SIM # Use SystemVerilog-2012
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
    filesets : [rtl]
    toplevel : [phy_transmit]
  
  sim:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - waiver.vlt
    filesets : [rtl]
    toplevel : [phy_transmit]

  verilate:
    flow: sim
    flow_options:
      tool : verilator
      cocotb_module : test_ltssm_configuration
      timescale: 1ns/1ns
      verilator_options:
        - --trace-fst
        - -Iincludes/
        - waiver.vlt
    filesets : [rtl]
    toplevel : [phy_transmit]

  synth:
    default_tool : vivado
    filesets : [rtl]
    tools:
      vivado:
        part : xc7a100tcsg324-1
    toplevel : phy_transmit

scripts:
  iceprog:
    cmd : [MODULE=pcie_ltssm_downstream]