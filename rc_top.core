CAPI=2:
# rc_top.core -- core for pcie_rc_top, the Root Complex down to the PIPE
#
# Author: Kourosh Ghahramani
# Silicon Systems Research Lab, University of Washington
#
# Purpose
#   Adds pcie_phy_top and pcie_rc_top to rc_core, with the LTSSM core and the
#   Data Link Layer, PHY receive and PHY transmit cores it depends on. It is
#   a core of its own so that a bench needing only rc_core does not pull in
#   the LTSSM and the PHY. pcie_phy_top.sv is listed here because no other
#   core lists it. This file sits at the repository root because it lists
#   files in src/rc and src/pcie_phy_core, and FuseSoC 2.4.6 warns that a
#   listed file outside the core file's directory is deprecated.

name: ::rc_top_core:1.0.0
description: >
  pcie_rc_top, the Root Complex from the enumeration engine to the PIPE,
  with pcie_phy_top.

filesets:
  rtl:
    depend:
      - ::rc_core:1.0.0
      - fusesoc:pcie:ltssm:1.0.0
      - fusesoc:pcie:lint
    files:
      - src/pcie_phy_core/pcie_phy_top.sv
      - src/rc/pcie_rc_top.sv
    file_type: systemVerilogSource

targets:
  default:
    filesets:
      - rtl

  # Lint-only elaboration of pcie_rc_top, where a missing pin shows with no
  # bench in the way; verilate_rc_top in tb/rc/tb_rc.core simulates the stack.
  # Run it as
  #       fusesoc run --build --target=lint ::rc_top_core
  # In lint-only mode the sim flow's run stage has nothing to run, so a bare
  # run fails after a clean lint (edalize 0.6.8); --build stops before that
  # stage (FuseSoC 2.4.6).
  lint:
    flow: sim
    flow_options:
      tool: verilator
      mode: lint-only
      timescale: 1ns/1ps
      verilator_options:
        - --timing
        - waiver.vlt
    filesets: [rtl]
    toplevel: [pcie_rc_top]
