# ---------------------------------------------------------------------------
# pcie_rc_gth_zcu102_refclk_r1p.xdc -- reference clock fallback R1' for
#                                      pcie_rc_gth_zcu102
#
# Author: Kourosh Ghahramani
# Silicon Systems Research Lab, University of Washington
#
# Purpose
#   Moves the PCIe reference clock input of pcie_rc_gth_zcu102 from FMC HPC1
#   GBTCLK0_M2C (MGTREFCLK0 of bank 130) to the ZCU102's SMA pair J79 / J80,
#   MGTREFCLK1 of bank 129, the lane's own quad. The 100 MHz then comes from
#   the adapter card by two SMA cables, so both ends still share one
#   oscillator. A fallback for a board on which the route from bank 130 does
#   not work; not the default.
#
# Usage
#   Read after pcie_rc_gth_zcu102.xdc, which it overrides for these two
#   ports only, and with PG239 generated by make_pg239_refclk <dir> r1p
#   (ip_pg239_refclk.tcl). Everything else, the 10 ns period of sys_clk
#   included, is pcie_rc_gth_zcu102.xdc's.
#
# Limitations
#   Not run on hardware. The SMA inputs have 0.1 uF series capacitors and no
#   termination on the ZCU102; the card's SMA output standard is not in our
#   records.
#
# References
#   UG1182, Table 3-36: ZCU102 GTH Bank 129 Interface Connections
#   UG1182, Figure 3-11
# ---------------------------------------------------------------------------

set_property PACKAGE_PIN J27 [get_ports sys_clk_p]        ;# MGTREFCLK1P_129  SMA J79
set_property PACKAGE_PIN J28 [get_ports sys_clk_n]        ;# MGTREFCLK1N_129  SMA J80
