# ---------------------------------------------------------------------------
# pcie_rc_gth_zcu102_refclk_r4.xdc -- reference clock fallback R4 for
#                                     pcie_rc_gth_zcu102
#
# Author: Kourosh Ghahramani
# Silicon Systems Research Lab, University of Washington
#
# Purpose
#   Moves the PCIe reference clock input of pcie_rc_gth_zcu102 from FMC HPC1
#   GBTCLK0_M2C (MGTREFCLK0 of bank 130) to the ZCU102's own Si570,
#   USER_MGT_SI570_CLOCK1 on MGTREFCLK0 of bank 129, the lane's own quad.
#   The Root Complex and the device in the slot then run from separate
#   oscillators. A fallback for a board on which the card's clock cannot be
#   used; not the default.
#
# Usage
#   Read after pcie_rc_gth_zcu102.xdc, which it overrides for these two
#   ports only, and with PG239 generated by make_pg239_refclk <dir> r4
#   (ip_pg239_refclk.tcl), which is make_pg239's configuration. Everything
#   else, the 10 ns period of sys_clk included, is pcie_rc_gth_zcu102.xdc's.
#
# Limitations
#   Not run on hardware. The Si570 starts at 156.25 MHz at every power-up
#   and must be set to 100 MHz over I2C before the design is released from
#   reset: sys_clk is constrained at 10 ns and PG239 is built for a 100 MHz
#   reference. The slot's spread spectrum must be off, since the two ends no
#   longer share a clock.
#
# References
#   UG1182, Table 3-36: ZCU102 GTH Bank 129 Interface Connections
#   UG1182, Table 3-12: ZCU102 Board Clock Sources
# ---------------------------------------------------------------------------

set_property PACKAGE_PIN L27 [get_ports sys_clk_p]        ;# MGTREFCLK0P_129  USER_MGT_SI570_CLOCK1_P
set_property PACKAGE_PIN L28 [get_ports sys_clk_n]        ;# MGTREFCLK0N_129  USER_MGT_SI570_CLOCK1_N
